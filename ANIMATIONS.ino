    drawScreen93,
    drawScreen_111
    
};

const int screenCount=sizeof(screens)/sizeof(screens[0]);

void runScreenSaver(){

    randomSeed(millis());

    int current=random(screenCount);
    unsigned long lastChange=millis();

    screens[current]();

    while(true){

        if(digitalRead(BTN_UP)==LOW||
           digitalRead(BTN_DOWN)==LOW||
           digitalRead(BTN_L)==LOW||
           digitalRead(BTN_R)==LOW||
           digitalRead(BTN_SELECT)==LOW||
           digitalRead(BTN_BACK)==LOW){

            waitRelease(BTN_UP);
            waitRelease(BTN_DOWN);
            waitRelease(BTN_L);
            waitRelease(BTN_R);
            waitRelease(BTN_SELECT);
            waitRelease(BTN_BACK);

            return;
        }

        if(millis()-lastChange>=5000){

            int next;

            do{
                next=random(screenCount);
            }while(next==current);

            current=next;

            screens[current]();

            lastChange=millis();
        }

        delay(10);
    }
}









